#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,5) RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   60       0     0     0>
            , <&key_physical_attrs 100 100  100   10       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   20       0     0     0>
            , <&key_physical_attrs 100 100  400   35       0     0     0>
            , <&key_physical_attrs 100 100 1200   35       0     0     0>
            , <&key_physical_attrs 100 100 1300   20       0     0     0>
            , <&key_physical_attrs 100 100 1400    0       0     0     0>
            , <&key_physical_attrs 100 100 1500   10       0     0     0>
            , <&key_physical_attrs 100 100 1600   60       0     0     0>
            , <&key_physical_attrs 100 100    0  160       0     0     0>
            , <&key_physical_attrs 100 100  100  110       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  120       0     0     0>
            , <&key_physical_attrs 100 100  400  135       0     0     0>
            , <&key_physical_attrs 100 100 1200  135       0     0     0>
            , <&key_physical_attrs 100 100 1300  120       0     0     0>
            , <&key_physical_attrs 100 100 1400  100       0     0     0>
            , <&key_physical_attrs 100 100 1500  110       0     0     0>
            , <&key_physical_attrs 100 100 1600  160       0     0     0>
            , <&key_physical_attrs 100 100    0  260       0     0     0>
            , <&key_physical_attrs 100 100  100  210       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  220       0     0     0>
            , <&key_physical_attrs 100 100  400  235       0     0     0>
            , <&key_physical_attrs 100 100 1200  235       0     0     0>
            , <&key_physical_attrs 100 100 1300  220       0     0     0>
            , <&key_physical_attrs 100 100 1400  200       0     0     0>
            , <&key_physical_attrs 100 100 1500  210       0     0     0>
            , <&key_physical_attrs 100 100 1600  260       0     0     0>
            , <&key_physical_attrs 100 100  370  350       0     0     0>
            , <&key_physical_attrs 100 100  490  335    1500   430   455>
            , <&key_physical_attrs 100 100  620  310    2300   430   455>
            , <&key_physical_attrs 100 100  585  245       0     0     0>
            , <&key_physical_attrs 100 100 1230  350       0     0     0>
            , <&key_physical_attrs 100 100 1030  600 (-1500)   205   455>
            , <&key_physical_attrs 100 100  830  705 (-2300)   205   455>
            , <&key_physical_attrs 100 100 1000  245       0     0     0>
            ;
    };

    chosen {
        zmk,physical-layout = &physical_layout0;
    };
};
